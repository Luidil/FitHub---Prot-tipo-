# ===== Front-end (públicas, vão para o navegador) =====
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# URL pública do app (usada nos links de pagamento enviados no WhatsApp)
VITE_PUBLIC_APP_URL=https://seu-app.vercel.app

# ===== Servidor (somente na Vercel, NUNCA com prefixo VITE_) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
PUBLIC_APP_URL=https://seu-app.vercel.app

# Provedor Pix da PLATAFORMA (só a assinatura SaaS que os clientes pagam ao FitHub): mock | mercadopago | asaas
# Mensalidades/inscrições dos clientes SEMPRE usam Pix direto na chave da organização.
# Não ligue PIX_CLIENT_SPLIT_ENABLED: só existirá quando houver split/subconta por organização.
PIX_CLIENT_SPLIT_ENABLED=false
PIX_PROVIDER=mock

# Mercado Pago (use o Access Token de TESTE para sandbox)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PAYER_EMAIL_FALLBACK=pagador@seudominio.com

# Asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=um-token-longo-aleatorio
VITE_SALES_WHATSAPP=5571999999999
